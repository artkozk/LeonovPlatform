APP_NAME=Leonov Care Platform
APP_ENV=development
HTTP_PORT=8080
MAX_REQUEST_BODY_BYTES=16777216
MAX_SUBMISSION_SOURCE_BYTES=8388608
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leonovcare?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_ACCESS_SECRET=change-access-secret
JWT_REFRESH_SECRET=change-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
FRONTEND_URL=http://localhost:5173
AUTO_MIGRATE=false
AUTO_SEED=false
SUBMISSION_QUEUE=submission_jobs
SUBMISSION_PROCESSING_QUEUE=submission_jobs_processing
SUBMISSION_MAX_ATTEMPTS=30
SUBMISSION_RECONCILE_INTERVAL=30s
SUBMISSION_RECONCILE_BATCH=200
JAVA_TIMEOUT_SECONDS=4
JUDGE_MODE=local
IDE_CHECKER_ALLOWED_COMMANDS=
FREE_DAILY_SUBMISSIONS=20
AUTH_RATE_LIMIT_PER_MINUTE=60
AI_HINT_RATE_LIMIT_PER_MINUTE=20
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
CARDLINK_BASE_URL=https://api.cardlink.example
CARDLINK_MERCHANT_ID=
CARDLINK_SHOP_ID=
CARDLINK_API_TOKEN=
CARDLINK_SECRET=
CARDLINK_WEBHOOK_TOKEN=change-me
CARDLINK_REQUIRE_SIGNATURE=true
CARDLINK_CURRENCY_IN=RUB
CARDLINK_LOCALE=ru
CARDLINK_BILL_TTL_SECONDS=1800
CARDLINK_RETURN_URL=
CARDLINK_SUCCESS_URL=
CARDLINK_FAIL_URL=
SUPPORT_EMAIL=support@leonovcare.local
EXPOSE_DEMO_TOKENS=false

# OpenAI (AI hints)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5.4-mini
OPENAI_HTTP_PROXY=
OPENAI_PROXY_HOST=
OPENAI_PROXY_PORT=
OPENAI_PROXY_USERNAME=
OPENAI_PROXY_PASSWORD=

# Google OAuth (ID token verification)
GOOGLE_CLIENT_ID=
